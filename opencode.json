{
  "$schema": "https://opencode.ai/schemas/config.json",
  "name": "crimson-lynx-run",
  "description": "In-app browser with security features",
  "project_type": "react-typescript",
  "path": ".",
  "ignore": [
    "node_modules/**",
    "dist/**",
    ".git/**",
    "*.lock",
    "package-lock.json"
  ],
  "tools": {
    "formatter": {
      "enabled": true,
      "command": "npx prettier --write",
      "extensions": ["ts", "tsx", "js", "jsx", "css", "json"]
    },
    "linter": {
      "enabled": false
    },
    "dependency_installer": {
      "enabled": true,
      "auto_install": false
    }
  },
  "read_only_files": [],
  "custom_instructions": "See AGENTS.md for detailed development guidelines"
}
